{
  "name": "el-plan",
  "productName": "EL PLAN",
  "version": "1.0.0",
  "description": "EL PLAN — precuela 8-bit de El Escape (edición elenco)",
  "author": "KazooGod02",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.kazoogod02.elplan",
    "productName": "EL PLAN",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "desktop/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "EL-PLAN-Edicion-Elenco.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
